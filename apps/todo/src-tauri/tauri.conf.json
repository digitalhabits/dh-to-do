{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Digital Habits To-Do",
  "version": "3.0.0",
  "identifier": "com.redd.do",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3472",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Digital Habits: To-Do",
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false,
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#faf8f5",
        "userAgent": "Mozilla/5.0 (Macintosh; Intel Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15 dh-todo-native/0.1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 Centre for Digital Habits CIC",
    "shortDescription": "Digital Habits: To-Do - Keep your goals in sight and get back to what you wanted to do",
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "Developer ID Application: Reduce Digital Distraction Ltd (JD647S9RT6)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["reddtodo", "redddo"]
      }
    }
  }
}
